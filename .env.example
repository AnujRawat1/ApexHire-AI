# Application Configuration
APP_NAME=ApexHire AI Service
APP_ENV=development
HOST=0.0.0.0
PORT=8000

# LLM Provider Configuration ("gemini" or "groq")
AI_PROVIDER=gemini
AI_MODEL=gemini-flash-latest
AI_TEMPERATURE=0.2
AI_MAX_OUTPUT_TOKENS=4096

# Provider Fallback
ENABLE_PROVIDER_FALLBACK=true
AI_FALLBACK_PROVIDER=groq
AI_FALLBACK_MODEL=qwen/qwen3.8-27b

# Provider API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Service-to-Service Authentication Key (Matches Spring Boot python.resume-service.api-key)
AI_SERVICE_API_KEY=apexhire-ai-service-secret-key-2026
PYTHON_SERVICE_API_KEY=apexhire-ai-service-secret-key-2026

# Timeouts & Retries
AI_REQUEST_TIMEOUT=120
AI_MAX_RETRIES=2

# CORS (Allowed origins, comma-separated)
CORS_ORIGINS=http://localhost:9000,http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=INFO